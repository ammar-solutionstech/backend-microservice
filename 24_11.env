# JWT Configuration (REQUIRED - change this!)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=auth-service

# RabbitMQ
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq

# SMTP (optional for now)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Auth Service
AUTH_DB_HOST=postgres-auth
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_PORT=8001
AUTH_GRPC_PORT=9001

# Help Desk Service
HELPDESK_DB_HOST=postgres-helpdesk
HELPDESK_DB_PORT=5432
HELPDESK_DB_NAME=helpdesk_db
HELPDESK_DB_USER=postgres
HELPDESK_DB_PASSWORD=postgres
HELPDESK_PORT=8002
HELPDESK_GRPC_PORT=9002
AUTH_SERVICE_GRPC=auth-service:9001

# Notification Service
NOTIFICATION_DB_HOST=postgres-notification
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=postgres
NOTIFICATION_DB_PASSWORD=postgres
NOTIFICATION_PORT=8003
NOTIFICATION_GRPC_PORT=9003

# Gateway
GATEWAY_PORT=8080
AUTH_SERVICE_GRPC=auth-service:9001
HELPDESK_SERVICE_GRPC=helpdesk-service:9002
NOTIFICATION_SERVICE_GRPC=notification-service:9003
LEGACY_DB_HOST=postgres-legacy
LEGACY_DB_PORT=5432
LEGACY_DB_NAME=ITaaS
LEGACY_DB_USER=postgres
LEGACY_DB_PASSWORD=postgres
LEGACY_DB_SCHEMA=public