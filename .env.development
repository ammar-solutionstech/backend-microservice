AUTH_SERVICE_GRPC_MTLS_CA=./certs/auth-ca.crt
AUTH_SERVICE_GRPC_MTLS_CLIENT_CERT=./certs/gateway-client.crt
AUTH_SERVICE_GRPC_MTLS_CLIENT_KEY=./certs/gateway-client.key
