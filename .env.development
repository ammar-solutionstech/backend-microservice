# ============================================
# Gateway Service
# ============================================
GATEWAY_PORT=8080
AUTH_SERVICE_GRPC=localhost:9001
HELPDESK_SERVICE_GRPC=localhost:9002
NOTIFICATION_SERVICE_GRPC=localhost:9003
INVENTORY_SERVICE_GRPC=localhost:9007
GEOGRAPHY_SERVICE_GRPC=localhost:9008
NAVIGATION_SERVICE_GRPC=localhost:9009
