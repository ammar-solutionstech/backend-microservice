NAVIGATION_SERVICE_GRPC_MTLS_CLIENT_KEY=./certs/gateway-client.key

# ============================================
# Agent Configuration (Development)
# ============================================
AGENT_DEVICE_ID=
AGENT_CONTAINER_ID=
AGENT_VERSION=1.0.0
AGENT_BACKEND_URL=https://localhost:8006
AGENT_BACKEND_GRPC_URL=localhost:9006
AGENT_BACKEND_CA_CERT=./certs/client-container-ca.crt
AGENT_CLIENT_CERT=./certs/agent-client.crt
AGENT_CLIENT_KEY=./certs/agent-client.key
AGENT_UPDATE_CHECK_INTERVAL=3600
AGENT_UPDATE_RETENTION=3
AGENT_HEALTH_REPORT_INTERVAL=300
AGENT_PLUGIN_TIMEOUT=30
AGENT_LOG_LEVEL=info
AGENT_LOG_FILE=
AGENT_LOG_FORMAT=json
