# ============================================
# Development Environment Configuration
# ============================================
# This file contains environment variables for running services locally (direct run command).
# Certificate paths use ./certs (relative paths from service root).
# Service hostnames use localhost.

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=auth-service

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq

# ============================================
# SMTP Configuration (Notification Service)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# ============================================
# Auth Service
# ============================================
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres
AUTH_PORT=8001
AUTH_GRPC_PORT=9001
# gRPC mTLS Server Configuration
GRPC_MTLS_CA_CERT=./certs/auth-ca.crt
GRPC_MTLS_SERVER_CERT=./certs/auth-server.crt
GRPC_MTLS_SERVER_KEY=./certs/auth-server.key
GRPC_MTLS_SERVER_KEY_PASSWORD=

# ============================================
# Helpdesk Service
# ============================================
HELPDESK_DB_HOST=localhost
HELPDESK_DB_PORT=5432
HELPDESK_DB_NAME=helpdesk_db
HELPDESK_DB_USER=postgres
HELPDESK_DB_PASSWORD=postgres
HELPDESK_PORT=8002
HELPDESK_GRPC_PORT=9002
AUTH_SERVICE_GRPC=localhost:9001
# gRPC mTLS Server Configuration
GRPC_MTLS_CA_CERT=./certs/helpdesk-ca.crt
GRPC_MTLS_SERVER_CERT=./certs/helpdesk-server.crt
GRPC_MTLS_SERVER_KEY=./certs/helpdesk-server.key
GRPC_MTLS_SERVER_KEY_PASSWORD=
# Auth Service gRPC mTLS Client Configuration
AUTH_SERVICE_GRPC_MTLS_CA=./certs/auth-ca.crt
AUTH_SERVICE_GRPC_MTLS_CLIENT_CERT=./certs/helpdesk-client.crt
AUTH_SERVICE_GRPC_MTLS_CLIENT_KEY=./certs/helpdesk-client.key

# ============================================
# Notification Service
# ============================================
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=postgres
NOTIFICATION_DB_PASSWORD=postgres
NOTIFICATION_PORT=8003
NOTIFICATION_GRPC_PORT=9003
# gRPC mTLS Server Configuration
GRPC_MTLS_CA_CERT=./certs/notification-ca.crt
GRPC_MTLS_SERVER_CERT=./certs/notification-server.crt
GRPC_MTLS_SERVER_KEY=./certs/notification-server.key
GRPC_MTLS_SERVER_KEY_PASSWORD=

# ============================================
# Certificate Service
# ============================================
CERTIFICATE_DB_HOST=localhost
CERTIFICATE_DB_PORT=5432
CERTIFICATE_DB_NAME=certificate_db
CERTIFICATE_DB_USER=postgres
CERTIFICATE_DB_PASSWORD=postgres
CERTIFICATE_PORT=8004
CERTIFICATE_GRPC_PORT=9004
STEP_CA_URL=https://localhost:9000
STEP_CA_AUDIANCE=
STEP_CA_TOKEN=
STEP_CA_PROVISIONER=admin
STEP_CA_USE_MTLS=false
STEP_CA_ROOT_CA=
STEP_CA_CERT=
STEP_CA_KEY=
STEP_CA_MANAGE_DOCKER=false
STEP_CA_KEY_PATH=
STEP_CA_KEY_PASSWORD=
# HTTP mTLS Server Configuration
MTLS_CA_CERT=./certs/certificate-ca.crt
CERTIFICATE_SERVER_CERT=./certs/certificate-server.crt
CERTIFICATE_SERVER_KEY=./certs/certificate-server.key
CERTIFICATE_SERVER_KEY_PASSWORD=
# gRPC mTLS Server Configuration
GRPC_MTLS_CA_CERT=./certs/certificate-ca.crt
GRPC_MTLS_SERVER_CERT=./certs/certificate-server.crt
GRPC_MTLS_SERVER_KEY=./certs/certificate-server.key
GRPC_MTLS_SERVER_KEY_PASSWORD=

# ============================================
# Container Management Service
# ============================================
CONTAINER_MGMT_DB_HOST=localhost
CONTAINER_MGMT_DB_PORT=5432
CONTAINER_MGMT_DB_NAME=container_mgmt_db
CONTAINER_MGMT_DB_USER=postgres
CONTAINER_MGMT_DB_PASSWORD=postgres
CONTAINER_MGMT_PORT=8005
CERTIFICATE_SERVICE_URL=https://localhost:8004
CERTIFICATE_SERVICE_CA=./certs/certificate-ca.crt
CERTIFICATE_SERVICE_CERT=./certs/container-management-client.crt
CERTIFICATE_SERVICE_KEY=./certs/container-management-client.key
CERTIFICATE_SERVICE_KEY_PASSWORD=
# HTTP mTLS Server Configuration
MTLS_CA_CERT=./certs/container-management-ca.crt
MTLS_SERVER_CERT=./certs/container-management-server.crt
MTLS_SERVER_KEY=./certs/container-management-server.key
MTLS_SERVER_KEY_PASSWORD=
# gRPC mTLS Server Configuration
GRPC_MTLS_CA_CERT=./certs/container-management-ca.crt
GRPC_MTLS_SERVER_CERT=./certs/container-management-server.crt
GRPC_MTLS_SERVER_KEY=./certs/container-management-server.key
GRPC_MTLS_SERVER_KEY_PASSWORD=
# Certificate Service gRPC mTLS Client Configuration
CERTIFICATE_SERVICE_GRPC_MTLS_CA=./certs/certificate-ca.crt
CERTIFICATE_SERVICE_GRPC_MTLS_CLIENT_CERT=./certs/container-management-client.crt
CERTIFICATE_SERVICE_GRPC_MTLS_CLIENT_KEY=./certs/container-management-client.key
# Bootstrap Token
BOOTSTRAP_TOKEN_SECRET=change-me-in-production
CSR_REQUIRED_ORG=
CSR_REQUIRED_COUNTRY=
# Docker Configuration
DOCKER_HOST=npipe:////./pipe/docker_engine
CLIENT_CONTAINER_IMAGE=backend_v1-client-container
CLIENT_CONTAINER_IMAGE_TAG=latest
CLIENT_CONTAINER_PORT=8006
CLIENT_CONTAINER_GRPC_PORT=9006
CLIENT_CONTAINER_DB_HOST=localhost
CLIENT_CONTAINER_DB_PORT=5432
CLIENT_CONTAINER_DB_NAME=client_container_db
CLIENT_CONTAINER_DB_USER=postgres
CLIENT_CONTAINER_DB_PASSWORD=postgres
CONTAINER_MGMT_SERVICE_URL=https://localhost:8005
NOTIFICATION_SERVICE_GRPC=localhost:9003
CERTIFICATES_PATH=./certs
DOCKER_NETWORK=microservices-network

# ============================================
# Client Container Service
# ============================================
CLIENT_CONTAINER_DB_HOST=localhost
CLIENT_CONTAINER_DB_PORT=5432
CLIENT_CONTAINER_DB_NAME=client_container_db
CLIENT_CONTAINER_DB_USER=postgres
CLIENT_CONTAINER_DB_PASSWORD=postgres
CLIENT_CONTAINER_PORT=8006
CLIENT_CONTAINER_GRPC_PORT=9006
CONTAINER_MGMT_SERVICE_URL=https://localhost:8005
CONTAINER_MGMT_SERVICE_CA=./certs/container-management-ca.crt
CONTAINER_MGMT_SERVICE_CERT=./certs/client-container-client.crt
CONTAINER_MGMT_SERVICE_KEY=./certs/client-container-client.key
CONTAINER_MGMT_SERVICE_KEY_PASSWORD=
CONTAINER_CERT_PATH=./certs/container.crt
CONTAINER_KEY_PATH=./certs/container.key
AGENT_CA_CERT_PATH=./certs/agent-ca.crt
NOTIFICATION_SERVICE_GRPC=localhost:9003
# gRPC mTLS Server Configuration
GRPC_MTLS_CA_CERT=./certs/client-container-ca.crt
GRPC_MTLS_SERVER_CERT=./certs/client-container-server.crt
GRPC_MTLS_SERVER_KEY=./certs/client-container-server.key
GRPC_MTLS_SERVER_KEY_PASSWORD=
# Notification Service gRPC mTLS Client Configuration
NOTIFICATION_SERVICE_GRPC_MTLS_CA=./certs/notification-ca.crt
NOTIFICATION_SERVICE_GRPC_MTLS_CLIENT_CERT=./certs/client-container-client.crt
NOTIFICATION_SERVICE_GRPC_MTLS_CLIENT_KEY=./certs/client-container-client.key
# Verification Code Settings
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_EXPIRY=15m
# Telemetry Retention
TELEMETRY_RETENTION_DAYS=90
# Plugin Repository
PLUGIN_REPOSITORY_URL=
# File Storage Paths
UPDATE_STORAGE_PATH=./data/updates
PLUGIN_STORAGE_PATH=./data/plugins
# Update Public Key
UPDATE_PUBLIC_KEY=

